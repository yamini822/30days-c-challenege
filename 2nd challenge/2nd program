#include <stdio.h>

int main() {
    float distance, mileage, price, fuel, cost;

    printf("Enter distance (km): ");
    scanf("%f", &distance);
    printf("Enter mileage (km/litre): ");
    scanf("%f", &mileage);
    printf("Enter fuel price (Rs/litre): ");
    scanf("%f", &price);

    fuel = distance / mileage;
    cost = fuel * price;

    printf("Fuel required = %.2f L\n", fuel);
    printf("Total fuel cost = Rs %.2f\n", cost);

    return 0;
}
